@model StudioRentalWeb.Models.ProfileViewModel
@{
    ViewData["Title"] = "Мой профиль";
}

<div class="container">
    <div class="hero" style="padding: 40px 0 20px;">
        <h1 style="font-size: 48px;">Мой профиль</h1>
        <p style="font-size: 16px;">Управление личными данными</p>
    </div>

    <div class="glass-panel" style="max-width: 600px; margin: 0 auto; padding: 40px;">
        <div asp-validation-summary="ModelOnly" class="alert alert-error" style="margin-bottom: 20px;"></div>

        <form method="post" asp-action="Profile">
            <div class="form-group">
                <label asp-for="FullName">ФИО</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger" style="color: #ef4444; font-size: 13px;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger" style="color: #ef4444; font-size: 13px;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone">Телефон</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger" style="color: #ef4444; font-size: 13px;"></span>
            </div>

            <div style="display: flex; gap: 16px; margin-top: 32px;">
                <button type="submit" class="btn btn-accent" style="flex: 1;">Сохранить изменения</button>
                <a href="/" class="btn btn-outline" style="flex: 1; text-align: center;">Отмена</a>
            </div>
        </form>
    </div>
</div>