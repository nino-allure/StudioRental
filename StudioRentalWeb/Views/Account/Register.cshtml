@model StudioRentalWeb.Models.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Регистрация - StudioRental</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="main-content">
        <div class="auth-container">
            <div class="auth-card">
                <h2>Создать аккаунт</h2>
                <p class="auth-subtitle">Присоединяйтесь к StudioRental</p>
                
                <!-- Блок для отображения общих ошибок (например, "Email уже занят") -->
                <div asp-validation-summary="ModelOnly" class="alert alert-error" style="margin-bottom: 20px;"></div>

                <form method="post" asp-action="Register" asp-controller="Account">
                    <div class="form-group">
                        <label asp-for="FullName">ФИО</label>
                        <input asp-for="FullName" class="form-control" placeholder="Иванов Иван Иванович" />
                        <span asp-validation-for="FullName" class="text-danger" style="color: #ef4444; font-size: 13px;"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="your@email.com" />
                        <span asp-validation-for="Email" class="text-danger" style="color: #ef4444; font-size: 13px;"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Phone">Телефон (опционально)</label>
                        <input asp-for="Phone" class="form-control" placeholder="+7 (999) 123-45-67" />
                        <span asp-validation-for="Phone" class="text-danger" style="color: #ef4444; font-size: 13px;"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Password">Пароль</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Минимум 6 символов" />
                        <span asp-validation-for="Password" class="text-danger" style="color: #ef4444; font-size: 13px;"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="ConfirmPassword">Подтверждение пароля</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Повторите пароль" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="color: #ef4444; font-size: 13px;"></span>
                    </div>
                    
                    <button type="submit" class="btn btn-accent btn-block">Зарегистрироваться</button>
                </form>
                
                <div class="auth-footer">
                    <p>Уже есть аккаунт? <a href="/Account/Login">Войти</a></p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>