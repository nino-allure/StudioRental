@model StudioRentalWeb.Models.RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Регистрация - StudioRental</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/paper.js/0.12.15/paper-full.min.js"></script>
    <style>
        .wave-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
        }

        #bend {
            position: absolute;
            z-index: 1;
            width: 100%;
            height: 100%;
            background: transparent;
        }

        .wave-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% 30%, rgba(10, 10, 12, 0.4) 0%, #0A0A0C 95%);
            z-index: 2;
            pointer-events: none;
        }

        .main-content {
            position: relative;
            z-index: 10;
            min-height: 100vh;
        }
    </style>
</head>
<body>

    <div class="wave-container">
        <canvas id="bend" resize></canvas>
        <div class="wave-overlay"></div>
    </div>

    <div class="main-content">
        <div class="auth-container">
            <div class="auth-card">
                <h2>Создать аккаунт</h2>
                <p class="auth-subtitle">Присоединяйтесь к StudioRental</p>

                <form method="post" asp-action="Register">
                    <div class="form-group">
                        <label>ФИО</label>
                        <input name="FullName" class="form-control" placeholder="Иванов Иван Иванович" required>
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input name="Email" class="form-control" type="email" placeholder="your@email.com" required>
                    </div>

                    <div class="form-group">
                        <label>Телефон (опционально)</label>
                        <input name="Phone" class="form-control" placeholder="+7 (999) 123-45-67">
                    </div>

                    <div class="form-group">
                        <label>Пароль</label>
                        <input name="Password" class="form-control" type="password" placeholder="Минимум 6 символов" required>
                    </div>

                    <div class="form-group">
                        <label>Подтверждение пароля</label>
                        <input name="ConfirmPassword" class="form-control" type="password" placeholder="Повторите пароль" required>
                    </div>

                    <button type="submit" class="btn btn-accent btn-block">Зарегистрироваться</button>
                </form>

                <div class="auth-footer">
                    <p>Уже есть аккаунт? <a href="/Account/Login">Войти</a></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function() {
            var canvas = document.getElementById('bend');
            if (canvas && typeof paper !== 'undefined') {
                paper.install(window);
                paper.setup(canvas);

                var h = window.innerHeight,
                    w = window.innerWidth,
                    horizon = h / 2,
                    pathCounts = 13,
                    pathPoints = 15,
                    strokeWidth = 2,
                    strokeColor = '#00FF66',
                    speed = 1.6,
                    offset = 7,
                    frequency = [0, -30, 50, -50, -35, 35, 0, -30, 50, -50, -35, 35, -30, 50, -50, -35, 35],
                    delay = 0.9,
                    path = [];

                function initializePath() {
                    h = window.innerHeight;
                    w = window.innerWidth;
                    horizon = h / 2;

                    if (paper.project) {
                        paper.project.activeLayer.removeChildren();
                    }

                    for (var i = 0; i < pathCounts; i++) {
                        path[i] = new paper.Path();
                        path[i].add(new paper.Point(-10, h));
                        path[i].add(new paper.Point(-10, horizon));

                        for (var p = 0; p < pathPoints - 1; p++) {
                            path[i].add(new paper.Point(w / (pathPoints - 1) * p + p, horizon + frequency[p]));
                        }

                        path[i].add(new paper.Point(w + 10, horizon));
                        path[i].add(new paper.Point(w + 10, h));
                        path[i].strokeWidth = strokeWidth;
                        path[i].strokeColor = strokeColor;
                        path[i].fillColor = 'rgba(0, 0, 0, 0)';
                        path[i].smooth();
                    }
                }

                initializePath();

                if (typeof view !== 'undefined') {
                    view.onFrame = function(event) {
                        for (var p = 0; p < pathCounts; p++) {
                            for (var s = 0; s < pathPoints; s++) {
                                var value = (s % 2) ? -1 : 1;
                                var segment = path[p].segments[2 + s];
                                if (segment) {
                                    segment.point.y = horizon + ((Math.sin((event.time + s * delay) * speed)) * (frequency[s] * value + (p * offset * value)));
                                }
                            }
                        }
                    };
                }

                window.onresize = function() {
                    initializePath();
                };
            }
        })();
    </script>

</body>
</html>