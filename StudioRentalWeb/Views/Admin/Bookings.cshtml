@model List<StudioRentalWeb.Models.Booking>

@{
    ViewData["Title"] = "Управление бронированиями";
}

<div class="container">
    <div class="admin-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h1 class="section-title" style="margin-bottom: 0;">Бронирования</h1>
        <a href="/Admin/ExportBookings" class="btn btn-success" style="background: #10b981; padding: 10px 20px; border-radius: 10px; color: white; text-decoration: none;">
            Экспорт в Excel
        </a>
    </div>

    <div class="admin-nav">
        <a href="/Admin">Главная</a>
        <a href="/Admin/Users">Пользователи</a>
        <a href="/Admin/Studios">Студии</a>
        <a href="/Admin/Bookings" class="active">Бронирования</a>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Клиент</th>
                    <th>Студия</th>
                    <th>Начало</th>
                    <th>Конец</th>
                    <th>Стоимость</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.Id</td>
                        <td>@booking.Customer?.FullName </td>
                        <td>@booking.Studio?.Name </td>
                        <td>@booking.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@booking.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@booking.TotalPrice.ToString("C")</td>
                        <td>
                            <span class="status-badge status-@booking.Status.ToLower()">
                                @(booking.Status == "Pending" ? "Ожидает" : booking.Status == "Confirmed" ? "Подтверждено" : "Отменено")
                            </span>
                        </td>
                        <td>
                            <div style="display: flex; gap: 8px;">
                                @if (booking.Status == "Pending")
                                {
                                    <form method="post" action="/Admin/ConfirmBooking/@booking.Id">
                                        <button type="submit" style="background: none; border: none; color: var(--success); cursor: pointer;">Подтвердить</button>
                                    </form>
                                    <form method="post" action="/Admin/CancelBooking/@booking.Id">
                                        <button type="submit" style="background: none; border: none; color: var(--danger); cursor: pointer;">Отменить</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>