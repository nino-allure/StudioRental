@* StudioRentalWeb\Views\Admin\CreateStudio.cshtml *@
@model StudioRentalWeb.Models.StudioViewModel

@{
    ViewData["Title"] = "Добавление студии";
}

<div class="container">
    <div class="hero" style="padding: 40px 0 20px;">
        <h1 style="font-size: 48px;">Добавление студии</h1>
        <p style="font-size: 16px;">Заполните информацию о новой студии</p>
    </div>

    <div class="admin-nav">
        <a href="/Admin">Главная</a>
        <a href="/Admin/Users">Пользователи</a>
        <a href="/Admin/Studios" class="active">Студии</a>
        <a href="/Admin/Bookings">Бронирования</a>
    </div>

    <div class="glass-panel" style="max-width: 800px; margin: 0 auto; padding: 40px;">
        <form method="post" action="/Admin/CreateStudio" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Название студии *</label>
                <input name="Name" class="form-control" placeholder="Prime Studio" required>
            </div>

            <div class="form-group">
                <label>Адрес *</label>
                <input name="Address" class="form-control" placeholder="Москва, ул. Тверская, 15" required>
            </div>

            <div class="form-group">
                <label>Цена за час (₽) *</label>
                <input name="PricePerHour" class="form-control" placeholder="2500" required>
            </div>

            <div class="form-group">
                <label>URL изображения (или загрузите файл ниже)</label>
                <input name="ImageUrl" class="form-control" placeholder="/img/studio.jpg">
            </div>

            <div class="form-group">
                <label>Или выберите файл изображения</label>
                <input type="file" name="image" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp"
                       onchange="previewImage(this)">
                <small style="color: var(--text-secondary);">Допустимые форматы: JPG, PNG, GIF, WEBP. Максимум 5MB</small>
                <div id="imagePreview" style="margin-top: 12px; display: none;">
                    <img id="previewImg" style="max-width: 200px; max-height: 150px; border-radius: 8px;">
                </div>
            </div>

            <div class="form-group">
                <label>Описание</label>
                <textarea name="Description" class="form-control" rows="5" placeholder="Профессиональная студия звукозаписи..."></textarea>
            </div>

            <div style="display: flex; gap: 16px; margin-top: 32px;">
                <button type="submit" class="btn btn-accent" style="flex: 1;">Сохранить студию</button>
                <a href="/Admin/Studios" class="btn btn-outline" style="flex: 1; text-align: center;">Отмена</a>
            </div>
        </form>
    </div>
</div>

<script>
    function previewImage(input) {
        var preview = document.getElementById('imagePreview');
        var previewImg = document.getElementById('previewImg');
        
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                preview.style.display = 'block';
            }
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.style.display = 'none';
        }
    }
</script>