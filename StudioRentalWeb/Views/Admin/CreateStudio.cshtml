@model StudioRentalWeb.Models.StudioViewModel

@{
    ViewData["Title"] = "Добавление студии";
}

<div class="container">
    <div class="admin-nav">
        <a href="/Admin">Главная</a>
        <a href="/Admin/Users">Пользователи</a>
        <a href="/Admin/Studios" class="active">Студии</a>
        <a href="/Admin/Bookings">Бронирования</a>
    </div>

    <div class="form-container" style="max-width: 800px; margin: 40px auto;">
        <h1 class="section-title" style="text-align: center;">Добавление новой студии</h1>

        <!-- Явно указываем action и метод -->
        <form method="post" action="/Admin/CreateStudio" style="background: var(--surface); padding: 32px; border-radius: 20px;">
            @Html.AntiForgeryToken()
            
            <div class="form-group">
                <label>Название студии *</label>
                <input name="Name" class="form-control" required>
            </div>

            <div class="form-group">
                <label>Адрес *</label>
                <input name="Address" class="form-control" required>
            </div>

            <div class="form-group">
                <label>Цена за час (₽) *</label>
                <input name="PricePerHour" class="form-control" type="number" step="100" required>
            </div>

            <div class="form-group">
                <label>URL изображения</label>
                <input name="ImageUrl" class="form-control" value="/img/gear.jpg">
            </div>

            <div class="form-group">
                <label>Описание</label>
                <textarea name="Description" class="form-control" rows="5"></textarea>
            </div>

            <div style="display: flex; gap: 16px; margin-top: 24px;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Сохранить студию</button>
                <a href="/Admin/Studios" class="btn btn-outline" style="flex: 1; text-align: center;">Отмена</a>
            </div>
        </form>
    </div>
</div>