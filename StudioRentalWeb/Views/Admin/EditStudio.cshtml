@* StudioRentalWeb\Views\Admin\EditStudio.cshtml *@
@model StudioRentalWeb.Models.StudioViewModel

@{
    ViewData["Title"] = "Редактирование студии";
}

<div class="container">
    <div class="hero" style="padding: 40px 0 20px;">
        <h1 style="font-size: 48px;">Редактирование студии</h1>
        <p style="font-size: 16px;">Измените информацию о студии</p>
    </div>

    <div class="admin-nav">
        <a href="/Admin">Главная</a>
        <a href="/Admin/Users">Пользователи</a>
        <a href="/Admin/Studios" class="active">Студии</a>
        <a href="/Admin/Bookings">Бронирования</a>
    </div>

    <div class="glass-panel" style="max-width: 800px; margin: 0 auto; padding: 40px;">
        <form method="post" asp-action="EditStudio" asp-controller="Admin" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            @* Вывод общих ошибок модели *@
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 20px;"></div>

            @* Скрытое поле для ID *@
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Name">Название студии *</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger" style="font-size: 14px; color: #ff4d4d;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Address">Адрес *</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger" style="font-size: 14px; color: #ff4d4d;"></span>
            </div>

            <div class="form-group">
                <label asp-for="PricePerHour">Цена за час (₽) *</label>
                <input asp-for="PricePerHour" class="form-control" />
                <span asp-validation-for="PricePerHour" class="text-danger" style="font-size: 14px; color: #ff4d4d;"></span>
            </div>

            <div class="form-group">
                <label>Текущее изображение</label>
                <div id="currentImageContainer" style="margin-bottom: 12px;">
                    @if (Model != null && !string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" style="max-width: 200px; max-height: 150px; border-radius: 8px;">
                    }
                    else
                    {
                        <div style="background: var(--bg-tertiary); padding: 20px; text-align: center; border-radius: 8px;">
                            <span style="color: var(--text-secondary);">Изображение не загружено</span>
                        </div>
                    }
                </div>

                <div style="display: flex; gap: 12px; margin-bottom: 16px;">
                    <label style="display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" name="removeImage" value="true">
                        <span style="color: #ef4444;">Удалить текущее изображение</span>
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ImageUrl">URL изображения (альтернатива)</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="/img/gear.jpg" />
                <span asp-validation-for="ImageUrl" class="text-danger" style="font-size: 14px; color: #ff4d4d;"></span>
            </div>

            <div class="form-group">
                <label>Или выберите новый файл изображения</label>
                <input type="file" name="image" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp"
                       onchange="previewImage(this)">
                <small style="color: var(--text-secondary);">Допустимые форматы: JPG, PNG, GIF, WEBP. Максимум 5MB</small>
                <div id="imagePreview" style="margin-top: 12px; display: none;">
                    <img id="previewImg" style="max-width: 200px; max-height: 150px; border-radius: 8px;">
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger" style="font-size: 14px; color: #ff4d4d;"></span>
            </div>

            <div style="display: flex; gap: 16px; margin-top: 32px;">
                <button type="submit" class="btn btn-accent" style="flex: 1;">Сохранить изменения</button>
                <a href="/Admin/Studios" class="btn btn-outline" style="flex: 1; text-align: center;">Отмена</a>
            </div>
        </form>
    </div>
</div>

<script>
    function previewImage(input) {
        var preview = document.getElementById('imagePreview');
        var previewImg = document.getElementById('previewImg');
        var currentContainer = document.getElementById('currentImageContainer');

        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
                preview.style.display = 'block';
                if (currentContainer) currentContainer.style.opacity = '0.5';
            }
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.style.display = 'none';
            if (currentContainer) currentContainer.style.opacity = '1';
        }
    }

    // Обработка чекбокса удаления
    var removeCheckbox = document.querySelector('input[name="removeImage"]');
    var imageUrlInput = document.querySelector('input[name="ImageUrl"]');
    var fileInput = document.querySelector('input[name="image"]');

    if (removeCheckbox) {
        removeCheckbox.addEventListener('change', function() {
            if (this.checked) {
                if (imageUrlInput) imageUrlInput.disabled = true;
                if (fileInput) fileInput.disabled = true;
            } else {
                if (imageUrlInput) imageUrlInput.disabled = false;
                if (fileInput) fileInput.disabled = false;
            }
        });
    }
</script>

@* Клиентская валидация средствами jQuery *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
