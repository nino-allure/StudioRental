@model StudioRentalWeb.Models.StudioViewModel

@{
    ViewData["Title"] = "Редактирование студии";
}

<div class="container">
    <div class="admin-nav">
        <a href="/Admin">Главная</a>
        <a href="/Admin/Users">Пользователи</a>
        <a href="/Admin/Studios" class="active">Студии</a>
        <a href="/Admin/Bookings">Бронирования</a>
    </div>

    <div class="form-container" style="max-width: 800px; margin: 40px auto;">
        <h1 class="section-title" style="text-align: center;">Редактирование студии</h1>

        <form method="post" action="/Admin/EditStudio" style="background: var(--surface); padding: 32px; border-radius: 20px;">
            @Html.AntiForgeryToken()

            <!-- Обязательно поле Id -->
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="form-group">
                <label>Название студии *</label>
                <input name="Name" class="form-control" value="@Model.Name" required>
            </div>

            <div class="form-group">
                <label>Адрес *</label>
                <input name="Address" class="form-control" value="@Model.Address" required>
            </div>

            <div class="form-group">
                <label>Цена за час (₽) *</label>
                <input name="PricePerHour" class="form-control" type="number" step="100" value="@Model.PricePerHour" required>
            </div>

            <div class="form-group">
                <label>URL изображения</label>
                <input name="ImageUrl" class="form-control" value="@(Model.ImageUrl ?? "/img/gear.jpg")">
            </div>

            <div class="form-group">
                <label>Описание</label>
                <textarea name="Description" class="form-control" rows="5">@Model.Description</textarea>
            </div>

            <div style="display: flex; gap: 16px; margin-top: 24px;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Сохранить изменения</button>
                <a href="/Admin/Studios" class="btn btn-outline" style="flex: 1; text-align: center;">Отмена</a>
            </div>
        </form>
    </div>
</div>

<script>
    // Отладка
    document.querySelector('form').addEventListener('submit', function(e) {
        console.log('Form submitted!');
        var formData = new FormData(this);
        for (var pair of formData.entries()) {
            console.log(pair[0] + ': ' + pair[1]);
        }
    });
</script>