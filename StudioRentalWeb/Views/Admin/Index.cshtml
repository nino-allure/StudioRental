@{
    ViewData["Title"] = "Админ панель";
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";

    if (!isAdmin)
    {
        Context.Response.Redirect("/Account/Login");
        return;
    }
}

<div class="container">
    <div class="hero" style="padding: 40px 0 20px;">
        <h1 style="font-size: 48px;">Админ панель</h1>
        <p style="font-size: 16px;">Управление платформой StudioRental</p>
    </div>

    <div class="admin-nav">
        <a href="/Admin" class="active">Главная</a>
        <a href="/Admin/Users">Пользователи</a>
        <a href="/Admin/Studios">Студии</a>
        <a href="/Admin/Bookings">Бронирования</a>
    </div>

    <!-- Bento Grid для статистики -->
    <div class="bento-grid">
        <div class="bento-card card-medium">
            <div class="stat-number">@ViewBag.UsersCount</div>
            <div class="stat-label">Пользователей</div>
        </div>
        <div class="bento-card card-medium">
            <div class="stat-number">@ViewBag.StudiosCount</div>
            <div class="stat-label">Студий</div>
        </div>
        <div class="bento-card card-medium">
            <div class="stat-number">@ViewBag.BookingsCount</div>
            <div class="stat-label">Бронирований</div>
        </div>
    </div>
</div>