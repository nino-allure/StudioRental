@model List<StudioRentalWeb.Models.Studio>

@{
    ViewData["Title"] = "Управление студиями";
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
    var studiosList = Model ?? new List<StudioRentalWeb.Models.Studio>();

    if (!isAdmin)
    {
        Context.Response.Redirect("/Account/Login");
        return;
    }
}

<div class="container">
    <div class="hero" style="padding: 40px 0 20px;">
        <h1 style="font-size: 48px;">Управление студиями</h1>
        <p style="font-size: 16px;">Добавление, редактирование и удаление студий</p>
    </div>

    <div class="admin-nav">
        <a href="/Admin">Главная</a>
        <a href="/Admin/Users">Пользователи</a>
        <a href="/Admin/Studios" class="active">Студии</a>
        <a href="/Admin/Bookings">Бронирования</a>
    </div>

    <!-- Actions Bar -->
    <div class="filter-card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; gap: 12px;">
            <a href="/Admin/CreateStudio" class="btn btn-accent">Добавить студию</a>
            <a href="/Admin/ExportStudios" class="btn btn-primary">Экспорт в Excel</a>
        </div>
        <div class="filter-group" style="flex: 0.3; min-width: 200px;">
            <input type="text" id="searchStudio" class="form-control" placeholder="Поиск студии...">
        </div>
    </div>

    <!-- Studios Table -->
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Адрес</th>
                    <th>Цена/час</th>
                    <th>Владелец</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="studiosTableBody">
                @foreach (var studio in studiosList)
                {
                    var studioId = studio.Id;
                    var studioName = studio.Name;
                    var studioAddress = studio.Address;
                    var shortAddress = studioAddress.Length > 40 ? studioAddress.Substring(0, 40) + "..." : studioAddress;
                    var studioPrice = studio.PricePerHour.ToString("N0");
                    var ownerName = studio.Owner?.FullName ?? "—";
                    var isApproved = studio.IsApproved;
                    var statusClass = isApproved ? "status-confirmed" : "status-pending";
                    var statusText = isApproved ? "Активна" : "На модерации";

                    <tr data-name="@studioName.ToLower()">
                        <td>@studioId</td>
                        <td><strong>@studioName</strong></td>
                        <td>@shortAddress</td>
                        <td style="color: #00FF66;">@studioPrice ₽</td>
                        <td>@ownerName</td>
                        <td><span class="status-badge @statusClass">@statusText</span></td>
                        <td>
                            <div style="display: flex; gap: 12px;">
                                <a href="/Admin/EditStudio/@studioId" class="btn btn-outline btn-sm" style="padding: 6px 12px;">Редактировать</a>
                                <a href="/Admin/ExportStudioReport/@studioId" class="btn btn-outline btn-sm" style="padding: 6px 12px; color: #00FF66;">Отчет</a>
                                <form method="post" action="/Admin/DeleteStudio/@studioId" onsubmit="return confirm('Удалить студию?')" style="display: inline;">
                                    <button type="submit" class="btn btn-outline btn-sm" style="padding: 6px 12px; color: #ef4444;">Удалить</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    var searchInput = document.getElementById('searchStudio');
    var tableRows = document.querySelectorAll('#studiosTableBody tr');

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            var searchTerm = this.value.toLowerCase();

            for (var i = 0; i < tableRows.length; i++) {
                var row = tableRows[i];
                var studioName = row.getAttribute('data-name') || '';
                if (studioName.indexOf(searchTerm) !== -1 || searchTerm === '') {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        });
    }
</script>