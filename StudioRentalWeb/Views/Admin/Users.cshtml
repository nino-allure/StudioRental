@model List<StudioRentalWeb.Models.User>

@{
    ViewData["Title"] = "Управление пользователями";
    var usersList = Model ?? new List<StudioRentalWeb.Models.User>();
    var totalUsers = usersList.Count;
    var adminCount = 0;
    var userCount = 0;
    var newUsersCount = 0;
    var thirtyDaysAgo = DateTime.Now.AddDays(-30);

    foreach (var u in usersList)
    {
        if (u.Role == "Admin") adminCount++;
        else userCount++;
        if (u.CreatedAt > thirtyDaysAgo) newUsersCount++;
    }
}

<div class="container">
    <div class="hero" style="padding: 40px 0 20px;">
        <h1 style="font-size: 48px;">Управление пользователями</h1>
        <p style="font-size: 16px;">Просмотр и управление пользователями платформы</p>
    </div>

    <div class="admin-nav">
        <a href="/Admin">Главная</a>
        <a href="/Admin/Users" class="active">Пользователи</a>
        <a href="/Admin/Studios">Студии</a>
        <a href="/Admin/Bookings">Бронирования</a>
    </div>

    <!-- Actions Bar -->
    <div class="filter-card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <a href="/Admin/ExportUsers" class="btn btn-accent">Экспорт в Excel</a>
        <div class="filter-group" style="flex: 0.3; min-width: 200px;">
            <input type="text" id="searchUser" class="form-control" placeholder="Поиск пользователя...">
        </div>
    </div>

    <!-- Bento Stats -->
    <div class="bento-grid" style="margin: 24px 0;">
        <div class="bento-card card-small" style="text-align: center;">
            <div class="stat-number">@totalUsers</div>
            <div class="stat-label">Всего пользователей</div>
        </div>
        <div class="bento-card card-small" style="text-align: center;">
            <div class="stat-number" style="color: #00FF66;">@adminCount</div>
            <div class="stat-label">Администраторов</div>
        </div>
        <div class="bento-card card-small" style="text-align: center;">
            <div class="stat-number" style="color: #3b82f6;">@userCount</div>
            <div class="stat-label">Пользователей</div>
        </div>
        <div class="bento-card card-small" style="text-align: center;">
            <div class="stat-number">@newUsersCount</div>
            <div class="stat-label">Новых за месяц</div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>ФИО</th>
                    <th>Email</th>
                    <th>Телефон</th>
                    <th>Роль</th>
                    <th>Дата регистрации</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">
                @foreach (var user in usersList)
                {
                    var userId = user.Id;
                    var userFullName = user.FullName;
                    var userEmail = user.Email;
                    var userPhone = string.IsNullOrEmpty(user.Phone) ? "-" : user.Phone;
                    var userRole = user.Role;
                    var roleText = userRole == "Admin" ? "Администратор" : "Пользователь";
                    var roleClass = userRole == "Admin" ? "status-confirmed" : "status-info";
                    var createdAt = user.CreatedAt.ToString("dd.MM.yyyy");
                    var isAdmin = userRole == "Admin";

                    <tr data-name="@userFullName.ToLower()" data-email="@userEmail.ToLower()">
                        <td>@userId</td>
                        <td><strong>@userFullName</strong></td>
                        <td>@userEmail</td>
                        <td>@userPhone</td>
                        <td><span class="status-badge @roleClass">@roleText</span></td>
                        <td>@createdAt</td>
                        <td>
                            @if (!isAdmin)
                            {
                                <form method="post" action="/Admin/DeleteUser/@userId" onsubmit="return confirm('Удалить пользователя?')" style="display: inline;">
                                    <button type="submit" class="btn btn-outline btn-sm" style="padding: 6px 12px; color: #ef4444;">Удалить</button>
                                </form>
                            }
                            else
                            {
                                <span class="gear-tag">Защищено</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    var searchInput = document.getElementById('searchUser');
    var tableRows = document.querySelectorAll('#usersTableBody tr');

    if (searchInput) {
        searchInput.addEventListener('input', function() {
            var searchTerm = this.value.toLowerCase();

            for (var i = 0; i < tableRows.length; i++) {
                var row = tableRows[i];
                var userName = row.getAttribute('data-name') || '';
                var userEmail = row.getAttribute('data-email') || '';
                if (userName.indexOf(searchTerm) !== -1 || userEmail.indexOf(searchTerm) !== -1 || searchTerm === '') {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            }
        });
    }
</script>