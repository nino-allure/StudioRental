@model StudioRentalWeb.Models.Studio

@{
    ViewData["Title"] = Model?.Name ?? "Студия";

    // Безопасное извлечение данных (защита от NullReferenceException)
    var studioName = Model?.Name ?? "Без названия";
    var studioAddress = Model?.Address ?? "Адрес не указан";
    var studioPriceFormatted = (Model?.PricePerHour ?? 0).ToString("N0");
    var studioId = Model?.Id ?? 0;

    // Заменяем захардкоженный localhost на относительный путь
    var studioImage = $"/api/Studios/{studioId}/image";

    var studioDescription = !string.IsNullOrEmpty(Model?.Description)
        ? Model.Description
        : "Профессиональная студия звукозаписи с новейшим оборудованием. Идеально подходит для записи вокала, инструментов и сведения.";
}

<div class="container">
    <!-- Studio Header -->
    <div class="studio-header">
        <div>
            <h1 class="section-title" style="margin-top: 0;">@studioName</h1>
            <p style="color: var(--text-secondary);">@studioAddress</p>
        </div>
        <div class="studio-price">@studioPriceFormatted ₽ <small>/ час</small></div>
    </div>

    <!-- Main Content Grid -->
    <div class="bento-grid" style="margin-top: 0;">
        <!-- Gallery Card -->
        <div class="bento-card card-large">
            <div class="studio-image" style="height: 300px;">
                <img src="https://localhost:7175/api/Studios/@studioId/image" alt="@studioName"
                     style="width: 100%; height: 100%; object-fit: cover;"
                     onerror="this.src='/img/studio1.jpg'">
            </div>
        </div>

        <!-- Booking Card -->
        <div class="bento-card card-medium">
            <h3 style="margin-bottom: 20px;">Забронировать</h3>

            @* Вывод серверных ошибок валидации, если бронирование не прошло *@
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 15px; font-size: 14px; color: #ff4d4d;"></div>

            <form method="post" action="/Bookings/Create" id="bookingForm">
                <input type="hidden" name="studioId" value="@studioId">

                <div class="form-group">
                    <label>Дата и время начала</label>
                    @* Динамическое ограничение "min" через ISO-формат *@
                    <input type="datetime-local" name="startTime" class="form-control" required
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")">
                </div>

                <div class="form-group">
                    <label>Дата и время окончания</label>
                    <input type="datetime-local" name="endTime" class="form-control" required
                           min="@DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")">
                </div>

                <button type="submit" class="btn btn-accent btn-block" style="margin-top: 20px;">Забронировать сейчас</button>
            </form>
        </div>

        <!-- Description Card -->
        <div class="bento-card card-small">
            <h3 style="margin-bottom: 16px;">Описание</h3>
            <p style="color: var(--text-secondary); line-height: 1.6;">@studioDescription</p>
        </div>
    </div>
</div>

<script>
    // Поиск элементов слотов (опционально, если они рендерятся на странице)
    var slots = document.querySelectorAll('.slot.available');
    for (var i = 0; i < slots.length; i++) {
        slots[i].addEventListener('click', function() {
            var allSlots = document.querySelectorAll('.slot.available');
            for (var j = 0; j < allSlots.length; j++) {
                allSlots[j].classList.remove('active');
                allSlots[j].style.background = '';
            }
            this.classList.add('active');
            this.style.background = 'rgba(0, 255, 102, 0.2)';

            var time = this.textContent.trim();
            // Получаем локальную дату в формате YYYY-MM-DD с учетом таймзоны пользователя
            var now = new Date();
            var offset = now.getTimezoneOffset() * 60000;
            var localISOTime = (new Date(now - offset)).toISOString().slice(0, 10);

            var startInput = document.querySelector('input[name="startTime"]');
            if (startInput) {
                startInput.value = localISOTime + 'T' + time;
            }
        });
    }

    // Валидация отправки формы
    var form = document.getElementById('bookingForm');
    if (form) {
        form.addEventListener('submit', function(e) {
            var startVal = this.querySelector('[name="startTime"]').value;
            var endVal = this.querySelector('[name="endTime"]').value;

            if (!startVal || !endVal) {
                alert('Пожалуйста, заполните обе даты.');
                e.preventDefault();
                return false;
            }

            var start = new Date(startVal);
            var end = new Date(endVal);
            var now = new Date();

            // Сбрасываем секунды для честного сравнения минут
            now.setSeconds(0, 0);

            if (start < now) {
                alert('Нельзя выбрать время в прошлом');
                e.preventDefault();
                return false;
            }

            if (end <= start) {
                alert('Время окончания должно быть позже начала');
                e.preventDefault();
                return false;
            }

            if ((end - start) < 60 * 60 * 1000) {
                alert('Минимальная длительность бронирования — 1 час');
                e.preventDefault();
                return false;
            }
        });
    }
</script>

<style>
    .slot.available.active {
        background: rgba(0, 255, 102, 0.2);
        border: 1px solid #00FF66;
        color: #00FF66;
    }
</style>